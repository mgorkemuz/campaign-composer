# Copy to .env and fill in. .env is gitignored.

# Claude API key. Leave empty to use the built-in mock LLM (no network calls).
ANTHROPIC_API_KEY=

# Only if your key is not scoped to one workspace (organization accounts):
# the ID of the workspace to bill, from the Claude Console.
ANTHROPIC_WORKSPACE_ID=

# Model for audience rules and message copy.
ANTHROPIC_MODEL=claude-haiku-5-5
